DATABASE_URL="postgresql://booking:booking@localhost:5432/booking?schema=public"
PORT=3000
JWT_SECRET="change-me"
SMTP_HOST=localhost
SMTP_PORT=1025
# Only needed for a real SMTP provider; Mailpit accepts anything.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Booking API <no-reply@booking.local>"
# "email" (SMTP below) or "log" (sends nothing, used by the public demo).
NOTIFIER_CHANNEL=email
# Global cap on notifications per UTC day (default 100).
NOTIFICATION_DAILY_LIMIT=100
