generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  name               String
  role               Role                @default(CLIENT)
  // Null until the emailed code is confirmed; unverified accounts can't log in.
  emailVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  professional       Professional?
  appointments       Appointment[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
}

// One active reset flow per user: emailed code -> verified -> reset token.
model PasswordReset {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash       String
  attempts       Int      @default(0)
  resetTokenHash String?  @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([userId])
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per UTC day, counting notifications sent, so a daily cap survives restarts.
model NotificationUsage {
  day   DateTime @id @db.Date
  count Int
}

model Professional {
  id                    String         @id @default(uuid())
  userId                String         @unique
  user                  User           @relation(fields: [userId], references: [id])
  bio                   String?
  // IANA name, e.g. "America/Mexico_City". Availability and time off are in this zone.
  timezone              String         @default("UTC")
  // null = no daily limit.
  maxAppointmentsPerDay Int?
  bufferMinutes         Int            @default(0)
  services              Service[]
  availability          Availability[]
  appointments          Appointment[]
  timeOff               TimeOff[]
}

// Whole days out of service, inclusive, in the professional's timezone.
model TimeOff {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([professionalId, startDate])
}

model Service {
  id              String        @id @default(uuid())
  professionalId  String
  professional    Professional  @relation(fields: [professionalId], references: [id])
  name            String
  durationMinutes Int
  priceCents      Int
  appointments    Appointment[]
}

// Weekly working hours. Minutes from midnight, in the professional's timezone.
model Availability {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id])
  weekday        Int // 0 = Sunday ... 6 = Saturday
  startMinute    Int
  endMinute      Int

  @@index([professionalId, weekday])
}

model Appointment {
  id             String            @id @default(uuid())
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id])
  clientId       String
  client         User              @relation(fields: [clientId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])
  startsAt       DateTime          @db.Timestamptz
  endsAt         DateTime          @db.Timestamptz
  status         AppointmentStatus @default(CONFIRMED)
  cancelledAt    DateTime?
  cancelledBy    Role?
  createdAt      DateTime          @default(now())

  rescheduleRequests RescheduleRequest[]

  @@index([professionalId, startsAt])
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  CANCELLED
}

// A client's proposal to move an appointment. At most one PENDING per appointment
// (partial unique index in the migration).
model RescheduleRequest {
  id              String           @id @default(uuid())
  appointmentId   String
  appointment     Appointment      @relation(fields: [appointmentId], references: [id])
  startsAt        DateTime         @db.Timestamptz
  endsAt          DateTime         @db.Timestamptz
  status          RescheduleStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime         @default(now())
  respondedAt     DateTime?

  @@index([appointmentId])
}
